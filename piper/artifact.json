{
  "name": "uncver-piper",
  "version": "1.0.0",
  "description": "Text-to-speech via espeak from Redis stream messages",
  "language": "go",
  "author": "uncver",
  "repository": "https://github.com/uncoverthefuture-org/uncver-artifact-lib/tree/main/piper",
  "network": "uncver-network",
  "container_image": "docker.io/uncoverthefuture/uncver-piper:latest",
  "environment": {
    "REDIS_ADDR": "uncver-redis-stream:6379",
    "AUDIO_STREAM": "uncver:stream:audio",
    "REGISTRY_STREAM": "uncver:stream:registry",
    "WINDOW_SECONDS": "60"
  }
}

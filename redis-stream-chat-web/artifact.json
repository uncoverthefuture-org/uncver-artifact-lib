{
  "name": "uncver-redis-stream-chat-web",
  "version": "1.1.0",
  "description": "Artifacts Stream — Redis stream chat + live stream viewer UI",
  "type": "web-interface",
  "author": "uncver",
  "repository": "https://github.com/uncoverthefuture-org/uncver-artifact-lib",
  "language": "nodejs",
  "license": "MIT",
  "container_image": "docker.io/uncoverthefuture/artifacts-stream-artifact:latest",
  "entrypoints": {
    "server": "src/server.js",
    "docker": "Dockerfile"
  },
  "environment": {
    "PORT": "3000",
    "REDIS_ADDR": "uncver-redis-stream:6379",
    "REDIS_PASSWORD": "",
    "STREAM": "uncver:ai:router"
  },
  "ports": ["3000:3000"],
  "network": "uncver-network",
  "gui_window": {
    "enabled": true,
    "port": 3000
  },
  "dependencies": [
    "redis",
    "ai-router"
  ],
  "build": {
    "command": "podman build -t artifacts-stream-artifact ."
  },
  "run": {
    "command": "podman run -d --name artifacts-stream --network uncver-network -p 3000:3000 -e REDIS_ADDR=uncver-redis-stream:6379 -e STREAM=uncver:ai:router artifacts-stream-artifact",
    "stop_command": "podman stop artifacts-stream && podman rm artifacts-stream"
  },
  "healthcheck": {
    "endpoint": "/health",
    "port": 3000
  },
  "features": [
    "websocket-chat",
    "redis-streams",
    "session-management",
    "message-history",
    "real-time-updates",
    "live-stream-viewer",
    "native-window",
    "random-source-colors"
  ]
}
